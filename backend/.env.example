# MongoDB and existing app settings
MONGO_URI=mongodb://127.0.0.1:27017/movieflex
JWT_SECRET=change-this-secret
PORT=5000

# Backblaze B2 S3-compatible API (copy values from B2 bucket + application key)
B2_KEY_ID=your_keyID
B2_APPLICATION_KEY=your_applicationKey
B2_BUCKET=movieflex-videos
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005

# Upload settings
MAX_VIDEO_SIZE=53687091200
UPLOAD_TEMP_DIR=./temp-uploads

# Comma-separated exact frontend origins allowed by the API
FRONTEND_URLS=https://movieflex98.onrender.com,http://localhost:5173

# B2 multipart part size; minimum 5 MB (8 MB recommended)
UPLOAD_CHUNK_SIZE=8388608
MAX_VIDEO_SIZE=53687091200
