# MongoDB and existing app settings
MONGO_URI=mongodb://127.0.0.1:27017/movieflex
JWT_SECRET=change-this-secret
PORT=5000

# Backblaze B2 S3-compatible API (must match the bucket's actual region; include https://)
B2_KEY_ID=your_keyID
B2_APPLICATION_KEY=your_applicationKey
B2_BUCKET=movieflex-videos
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005

# Upload settings
MAX_VIDEO_SIZE=53687091200
UPLOAD_CHUNK_SIZE=8388608

# Local development and Render Free (temporary, non-persistent filesystem):
# On Render Free, do NOT set this to /var/data (Persistent Disk is not available).
# The temporary upload chunks can be lost on restart/spin-down and are limited
# by the free instance's available temporary disk space.
# UPLOAD_TEMP_DIR=/tmp/movieflex-uploads

# Exact frontend origin(s), comma-separated; required by backend CORS policy
FRONTEND_URL=https://your-frontend.onrender.com
