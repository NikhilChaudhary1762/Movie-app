# MongoDB and application settings
MONGO_URI=mongodb://127.0.0.1:27017/movieflex
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000

# Backblaze B2 S3-Compatible API (Private bucket)
# Copy the endpoint and region exactly from Backblaze > Buckets > your bucket.
B2_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET=your_bucket_name
B2_ENDPOINT=https://s3.us-west-005.backblazeb2.com
B2_REGION=us-west-005

# Private B2 does NOT need B2_PUBLIC_BASE_URL.
# The API stores b2:// object keys and returns temporary signed HTTPS playback URLs.

# Upload settings
MAX_VIDEO_SIZE=53687091200
UPLOAD_TEMP_DIR=./temp-uploads
UPLOAD_CHUNK_SIZE=8388608
